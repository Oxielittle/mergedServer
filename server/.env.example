# Core
NODE_ENV=development
PORT=8000
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/sagipbayan
SESSION_SECRET=replace-with-a-long-random-secret
USER_AUTH_TOKEN_SECRET=replace-with-a-different-long-random-secret
FRONTEND_URLS=http://localhost:8081,http://localhost:19006
PUBLIC_API_URL=http://localhost:8000

# One-time administrator bootstrap. Keep these only in the deployment environment.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_ADDRESS=

# YOLO agent authentication. Configure the same value on the trusted agent machine.
YOLO_AGENT_TOKEN=replace-with-a-long-random-agent-token

# Optional email provider (configure either Resend or SMTP)
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional media storage
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Optional analytics providers
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=